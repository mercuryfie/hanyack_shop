}

.inputSearch2 {
    border: 1px solid #ccc;
    width: 280px;
    height: 24px;
    margin-right: 10px;
    font-size: 12px;
}

.bubbleBox {
    position: relative;
    z-index: 0;
}
.bubbleBox .bubbleicon {
    z-index: 0;
}
.bubble {
    z-index: 20;
    border:1px solid #ccc;
    background-color: #fff;
    padding: 10px 20px;
    width: 220px;
    height: 120px;
    max-width: 220px;
    max-height: 120px;

    position: absolute;
    top:-120px;
    left:20px;
    /*transform: translateX(-50%);*/
    font-size: 16px;

    overflow: hidden;
    overflow-y: scroll;
    scroll-behavior: auto;

    text-wrap: wrap;
    text-align: left;
}
.bubble .title {
    font-weight: 500;
}
.bubble .hn_type {
    margin: 10px 0;
}

.bubbleWrap {
    position: relative;
    z-index: 20;
    display: none;

}

.bubble2 {
    border-radius: 10px;
    background-color: #00000021;
    padding: 4px 20px;
    width: auto;
    height: 32px;
    /*max-width: 120px;*/

    position: absolute;
    top:-60px;
    left:-20%;
    transform: translateX(-50%);
    font-size: 14px;

    /*overflow: hidden;*/
    text-wrap: nowrap;
    text-align: left;


}

