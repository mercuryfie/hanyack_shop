}

.inputType140 {
    border: 1px solid #ccc;
    width: 140px;
    height: 24px;
    line-height: 24px;
    font-size: 14px;
}

.periodSelected {
    border: 1px solid var(--second-color) !important;
    color: var(--second-color);
}

.lastBox {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    height: 80px;
    margin-bottom: 20px;
}
.modiLastBox {
    margin-right: 60px;
}
.mb40 {
    margin-bottom: 40px;
}

.mb5 {
    margin-bottom: 5px;
}
.mb10 {
    margin-bottom: 10px;
}

.mb20 {
    margin-bottom: 20px;
}

.h32 {
    height: 32px;
}

.ttlCnt {
    color: var(--main-color);
    font-size: 18px;
    font-weight: 600;
}
.p5 {
    padding: 5px 0;
}

.p10 {
    padding: 10px 0;
}

.ph10 {
    padding: 0 10px;
}
.ph20 {
    padding: 0px 20px;
}

.p40 {
    padding: 40px 0;
}

.color5c {
    color:#5c5c5c;
}


/* footer ------------------------------------------  */

footer {
    /*position: relative;*/
    /*position: sticky;*/
    /*bottom: 0;*/
}

.footerwrap {
    background-color: var(--cartbg80);
    width: 100vw;
    height: 220px;
    display: flex;
    justify-content: center;
    /*display: sticky;*/
}

.whitefoot {
    margin-top: 0px;
    background-color: #fff;
}

.footerwrap > img {
    width: 180px;
    height: 40px;
    object-fit: cover;
    margin-right: 60px;
    margin-top: 60px;
    display: inline-block;
}

.footul {
    margin-top: 20px;
    width: 860px;
    display: flex;
}

.footul > li {
    margin-right: 60px;
    color: #5c5c5c;
}

.footul > li > ul > li {
    font-size: 14px;
}

.footul > li > ul > li:first-child {
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 20px;
}

.ful1 > li {
    width: 320px;
}

.ful2 > li,
.ful3 > li,
.ful4 > li {
    width: 120px;
}

.bottomline {
    width: 100vw;
    height: 26px;
    background-color: var(--color2);
    /*color: #fff;*/
    text-align: center;
    z-index: 20;
    /* position: fixed;
    bottom: 0;
    left: 0; */
    padding-top: 5px;
    font-size: 12px;
    font-weight: normal;
}

@media screen and (min-width: 2560px) {

    main,
    .merregister {
        min-height: 1080px;
        height: auto;
    }
}

@media screen and (max-width: 1440px) {
    /* login_View start  -------------------------------- */
    main,
    .merregister {
        min-height: 580px;
        height: auto;
    }

    .login {
        height: 450px;

    }

    .login > p {
        margin: 20px 0;

    }

}