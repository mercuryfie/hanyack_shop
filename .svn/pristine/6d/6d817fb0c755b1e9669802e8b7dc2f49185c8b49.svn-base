* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Noto Sans KR", sans-serif;
    /*color: red;*/
}

body {
    overflow-x: hidden;
}

main section {
    background-color: var(--cartbg40);
    /*overflow-x: hidden !important;*/
}

ul {
    list-style-type: none;
}

a {
    text-decoration: none;
    color: inherit;
}


html.body-no-scroll,
body.body-no-scroll {
    overflow: hidden !important;
    height: 100% !important;
}


@media print {
    body {
        margin: 0 !important;
    }

    .btn-wrap, .popclosePrint,
    .printOpen, .print-info {
        display: none;
    }

    a {
        color: #000 !important;
        text-decoration: none !important;
    }

    .pop_prn_barcode_con {
        margin: 2mm;
    }


}

.main-container {
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
}

.ck-content {
    line-height: 1.6;
    word-break: break-word;
}

.editor-container_classic-editor .editor-container__editor {
    min-width: 795px;
    max-width: 795px;
}

:root {
    --main-color: #1067FF;
    --color2: #D9E7FF;
    --color3: #75a7ff;
    --tag-color: #dee9ff;
    /*--main-color20: #00996510;*/
    /*--main-color40: #00996540;*/
    /*--main-bg: #F9FAFB;*/
    /*--sub-color: #edf1ef;*/
    /*--second-color: #5e9b76;*/
    /*--third-color: #b0ddc2;*/
    /*--forth-color: #8bffb9;*/
    /*--fifth-color: #1d3627;*/
    /*--sixth-color: #fc88ad;*/
    /*--orange: #ff8207;*/
    /*--eigth-color: #c975ed;*/
    /*--ninth-color: #6eec9a;*/
    /*--mint-color: #79f8d8;*/
    /*--tag-color: #b7ffd3;*/
    --bg-color1: #f1f1f16f;
    --bg-color2: #ececec;
    --bg-color3: #ccc;
    --bg-color4: #dedede;
    --bg-color5: #F2F2F2;
    --cartbg: #f2f5f8;
    --cartbg40: #f2f5f880;
    --gray-cart001: #848f9a;
    --grayColor1: #848f9a;
    /*--yellow: #f3df14;*/
    --ck-z-default: 100;
    --ck-z-panel: calc( var(--ck-z-default) + 999 );
}

::selection {
    background-color: var(--color2); /* 드래그 배경색 */
    color: #000; /* 드래그된 텍스트 색상 */
}

input[type="checkbox"] {
    accent-color: var(--main-color); /* 체크 표시 색상 (예: 토마토색) */
}

input[type="search"] {
    outline: none;
}

input[type="radio"] {
    accent-color: #4b6957;
    margin-right: 5px;
}

.m0a {
    margin: 0 auto;
}

.mt10 {
    margin-top: 10px;
}
.mt20 {
    margin-top: 20px;
}

.mt40 {
    margin-top: 40px;
}

.pt10 {
    padding-top: 10px;
}

.pt20 {
    padding-top: 20px;
}




.wishHeartBox  {
    border:1px solid #ccc;
    border-radius: 50%;
    width: 30px;
    height: 30px;
}


.wishHeart {
    color:#ccc;
    font-size: 16px;
}


.wishHeartBox.active  {
    border: 1px solid var(--color3);
}

.wishHeart.active {
    color: var(--color3);
}

.datepicker-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 4px 8px;
}

.datepicker-wrapper input {
    border: none;
    outline: none;
    padding-right: 8px; /* 아이콘과의 간격 */
}

.datepicker-wrapper .calendar-icon {
    cursor: pointer;
    /* 아이콘 크기나 색상 지정 */
}

.noto-sans-kr {
    font-family: "Noto Sans KR", sans-serif;
    font-optical-sizing: auto;
    font-weight: 200;
    font-style: normal;
}

#wrap {
    width: 1180px;
    height: auto;
    margin: 0 auto;
    padding: 10px 0;
}


/* common pop style start  */

.unitType1 {
    font-size: 14px;
    margin-left: 10px;
    color: #5c5c5c;
}

.common_pop_wrap {
    display: none;
    position: fixed;
    z-index: 30;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    overflow: hidden;

}

.common_pop_conkol {
    background-color: #fff;
    border-radius: 10px;
    z-index: 32;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    overflow-y: auto; /* 안쪽만 스크롤 */
    overflow-x: hidden
}

.common_pop_conkol .area1 {
    padding: 10px 0;
    position: relative;
}

.common_pop_conkol .area1 .pop_head_title {
    font-size: 20px;
    font-weight: 600;
    text-align: center;
}

.common_pop_conkol .area1 i {
    position: absolute;
    top: 12px;
    right: 20px;
    font-size: 22px;
}

.common_pop_conkol .lastArea {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: 20px;
}


.common_pop_conkol .lastArea .btn_close {
    width: 60px;
    height: 30px;
}

/* common pop style end  */

/* header ------------------------------------------  */


.topline {
    width: 100vw;
    height: 20px;
    background-color: var(--main-color);
    color: white;
    font-size: 12px;
    text-align: center;
    text-decoration: underline;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    cursor: pointer;
}


.logo {
    width: 200px;
    /*margin-left: 40px;*/
    cursor: pointer;
    object-fit: cover;
}

.searchicon {
    position: absolute;
    top: 110px;
    left: 66%;
    transform: translateX(-66%);
    font-size: 24px;
    color: var(--main-color);
}

.mainSearch {
    border: 1px solid var(--main-color);
    font-weight: normal;
    font-size: 16px;
    padding-left: 10px;
}


.iconbox {
    width: 170px;
    height: 70px;
    display: flex;
    justify-content: right;
    position: absolute;
    top: 40%;
    right: 0;
}

.icons {
    display: flex;
}

.iconbox > div > i {
    background-color: #fff;
    margin-right: 10px;
    width: 48px;
    height: 48px;
    line-height: 48px;
    font-size: 28px;
    color: var(--main-color);
    text-align: center;
    cursor: pointer;
    visibility: visible;
    opacity: 1;
}

.hidden {
    visibility: hidden;
    opacity: 0;
    transition: visibility 0s,
    opacity 0.3s ease;
}

.icons > i:last-child {
    margin-right: 0;
}

/* .icon1 {
    position: relative;
} */
.locatip {
    display: none;
    border: 1px solid #ccc;
    width: 320px;
    height: 200px;
    background-color: #fff;
    color: #000;
    /* padding: 0 20px; */
    position: absolute;
    top: 60px;
    right: 110px;
    /* right: 25%;
    transform: translatex(-25%); */
    z-index: 9;
    border-radius: 5px;
}

.locatip::after {
    content: "";
    position: absolute;
    top: -10px;
    right: 10px;
    width: 0px;
    height: 0px;
    border: 10px solid transparent;
    border-bottom-color: #ccc;
    border-top: 0;
    margin-left: 0px;
    margin-bottom: 0px;
}

.locatip > p {
    font-size: 18px;
    font-weight: normal;
    text-align: center;
    line-height: 30px;
    width: 220px;
    margin: 0 auto;
    word-wrap: break-word; /* 긴 단어를 강제로 줄바꿈 */
    overflow-wrap: break-word; /* 위와 동일한 기능, 더 최신 속성 */
    white-space: normal; /* 공백 처리 방식을 기본값으로 설정 */
    padding-top: 30px;
}

.locatip > button {
    border: 1px solid var(--main-color);
    background-color: #fff;
    width: 280px;
    height: 50px;
    font-size: 12px;
    color: var(--main-color);
    border-radius: 5px;
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    cursor: pointer;
}


/*toggle start ------------------*/
.toggle_btn {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
}

.toggle_btn input {
    display: none;
}

.toggle_slider {
    position: absolute;
    inset: 0;
    cursor: pointer;
    background: #ccc;
    border-radius: 20px;
    transition: 0.2s;
}

.toggle_slider::before {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    left: 3px;
    top: 3px;
    background: #fff;
    border-radius: 50%;
    transition: 0.2s;
}

.toggle_btn input:checked + .toggle_slider {
    background: var(--main-color);
    /*background-color: red;*/
    box-shadow:
            inset 0 0 5px rgba(0, 0, 0, 0.35),
            inset 0 1px 1px rgba(255, 255, 255, 0.25);
    /*background: var(--main-color20);*/
}

.toggle_btn input:checked + .toggle_slider::before {
    transform: translateX(16px);
}

/*toggle end ------------------*/
.fontType1 {
    font-size: 12px;
    color: #8d8d8d;
}
.fontStyle5c14{
    color:#5c5c5c;
    font-size:14px;
}

.fontStyle14{
    font-size:14px;
}

.fontStyle16{
    color:#5c5c5c;
    font-size:16px;
}


.unmatched {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: red;
}

.matched {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: rgb(42, 239, 88);
}


/* spinnerBox start--------------- */
/* spinnerBox end--------------- */
/* spinnerBox start--------------- */

.spinnerBox,
.spinner {
    display: none;
}

.spinnerBox {
    position: fixed;
    z-index: 100;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.05);

}

.spinner {
    width: 24px;
    height: 24px;
    z-index: 101;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.spinnerBox.active, .spinner.active {
    display: block;
}

.must {
    background-color: red;
    border-radius: 50%;
    width: 5px;
    height: 5px;
    text-align: right;
    margin-right: 10px;
    /*margin-top: 10px;*/
    /*margin-right: 10px;*/
    /*margin-bottom: 20px;*/

}

.notmust {
    background-color: transparent;
    border-radius: 50%;
    width: 5px;
    height: 5px;
    text-align: right;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 20px;

}
