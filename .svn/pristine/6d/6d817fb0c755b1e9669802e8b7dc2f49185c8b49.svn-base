/*  submenu1 ----------------*/
.topmenu > a:hover {
    text-decoration: underline;
    color: var(--second-color);
}

.submenu1-4,
.submenu1-1,
.submenu1-2,
.submenu1-3 {
    padding: 40px 0;
    width: 120px;
    height: 280px;
    border-radius: 0px 10px 10px 0px;
    position: absolute;
    top: 0;
    left: 0px;
    background-color: #ececec61;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    z-index: 10;
    display: flex;
    flex-flow: column;
    display: none;
}

.submenu1-4 > a,
.submenu1-1 > a,
.submenu1-2 > a,
.submenu1-3 > a {
    width: 120px;
    height: 40px;
    line-height: 40px;
    font-size: 14px;
    display: inline-block;
    color: black;
    text-decoration: none;
    text-align: center;
}

.submenu > a:hover {
    background-color: #fff;
    color: var(--second-color);
    text-decoration: underline;
}


.topmenu1-2:hover ~ .submenu1-4,
.topmenu1-2:hover ~ .submenu1-2,
.topmenu1-1:hover ~ .submenu1-1 {
    display: inline-block;
}

